{
  "name": "@trusona/trucode",
  "version": "2.1.0",
  "description": "Render and monitor animated TruCodes in modern browsers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/trucode.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test",
    "check": "npm test && npm audit --audit-level=high",
    "prepack": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trusona/trusona-trucode-sdk-js.git"
  },
  "bugs": {
    "url": "https://github.com/trusona/trusona-trucode-sdk-js/issues"
  },
  "homepage": "https://github.com/trusona/trusona-trucode-sdk-js#readme",
  "author": "engineering@trusona.com",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "keywords": [
    "trusona",
    "trucode",
    "authentication",
    "qrcode"
  ]
}
